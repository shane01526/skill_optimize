{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["report_date", "total_count", "transactions"],
  "additionalProperties": false,
  "properties": {
    "report_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "total_count": {"type": "integer", "minimum": 0},
    "transactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "amount", "currency", "status", "counterparty"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "amount": {"type": "number"},
          "currency": {"type": "string", "enum": ["TWD", "USD", "EUR", "JPY"]},
          "status": {"type": "string", "enum": ["settled", "pending", "failed"]},
          "flagged": {"type": "boolean"},
          "counterparty": {
            "type": "object",
            "required": ["name", "country"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "country": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
